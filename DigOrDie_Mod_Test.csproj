<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net35</TargetFramework>
    
    <AssemblyName>MyFirstMod</AssemblyName>
    <Description>My first DigOrDie mod</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>5</LangVersion> 
    <RootNamespace>MyFirstMod</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 依赖项引用 (保持不变，路径已确认是正确的) -->
    <Reference Include="BepInEx">
      <HintPath>E:\SteamLibrary\steamapps\common\Dig or Die\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>E:\SteamLibrary\steamapps\common\Dig or Die\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>E:\SteamLibrary\steamapps\common\Dig or Die\DigOrDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>E:\SteamLibrary\steamapps\common\Dig or Die\DigOrDie_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png">
